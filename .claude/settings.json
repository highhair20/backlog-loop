{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-created-review.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for new PR..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-review-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking PR review loop..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__actions_run_trigger",
      "mcp__github__pull_request_review_write",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "Bash(gh pr merge:*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(git push)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *+main*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *--ta*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * v*)",
      "Bash(git push *--fol*)",
      "Bash(git push *+v*)",
      "Bash(git -* push*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * :refs/*)",
      "Bash(git push * :main)",
      "Bash(git push * :main *)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git ls-remote *--upload-pack*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git -c*)",
      "Bash(git --config-env*)",
      "Bash(git config *)"
    ]
  }
}
