{
  "permissions": {
    "allow": [
      "Bash(command -v gh)",
      "Bash(gh auth status*)",
      "Bash(scripts/gh-auth-check.sh)",
      "Bash(date -u +%Y-%m-%dT%H:%M:%SZ)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(hostname)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit * --remove-label *)",
      "Bash(gh run view *)",
      "Bash(gh api repos/{owner}/{repo}/pulls/*/comments --paginate)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "Bash(git merge --no-edit origin/main)",
      "Bash(git merge --abort)",
      "Bash(git rev-parse -q --verify MERGE_HEAD)",
      "Bash(git switch *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --no-rebase --no-edit origin *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git ls-remote --heads origin)",
      "Bash(git ls-remote --heads origin *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(scripts/check-verify-section.sh *)",
      "Bash(scripts/loop-lock.sh check)",
      "Bash(scripts/report-drained.sh)",
      "Bash(*/.claude/hooks/pr-review-state.sh *)",
      "Bash(.claude/hooks/pr-review-state.sh *)",
      "Bash(git remote get-url *)"
    ]
  }
}
